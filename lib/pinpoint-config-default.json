{
    "collector": {
        "ip": "localhost",
        "span": {
            "port": 9993,
            "batchSize": 20,
            "deadlineMillis": 500,
            "maxRequests": 10,
            "compression": "gzip"
        },
        "stats": {
            "port": 9992,
            "compression": "gzip"
        },
        "agent": {
            "port": 9991
        },
        "deadlineMinutes": 10
    },
    "sampling": {
        "enable": true,
        "rate": 10
    },
    "enable": true,
    "plugins": {
        "http": {
            "errorStatusCodes": "5xx,401,403"
        },
        "express": true,
        "koa": true,
        "mongodb": true,
        "redis": true,
        "ioredis": true,
        "mysql": true,
        "postgresql": true
    },
    "features": {
        "activeThreadCount": true,
        "dataSending": true,
        "statsMonitoring": true,
        "gcStats": false,
        "fileDescriptorStats": false,
        "uriStats": {
            "httpMethod": false,
            "capacity": 1000,
            "useUserInput": true
        },
        "errorAnalysis": {
            "maxDepth": 10
        },
        "logLevels": {
            "default-logger": "WARN",
            "grpcLogger": "SILENT"
        }
    }
}
{
    "agentId": "node.test.app",
    "applicationName": "test.application.name",
    "serviceName": "test.service.name",
    "collector": {
        "ip": "localhost",
        "spanPort": 9993,
        "statPort": 9992,
        "tcpPort": 9991,
        "deadlineMinutes": 10
    },
    "sampling": {
        "enable": true,
        "rate": 1
    },
    "enable": true,
    "plugins": {
        "http": {
            "errorStatusCodes": "5xx,401,403"
        }
    },
    "features": {
        "dataSending": true,
        "statsMonitoring": false,
        "container": false,
        "sqlStats": false,
        "uriStats": {
            "httpMethod": true,
            "capacity": 1000,
            "useUserInput": true
        },
        "logLevels": {
            "default-logger": "WARN",
            "grpcLogger": "SILENT"
        }
    }
}